# Sanity CMS — required for live CMS content and Studio
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Server-only — never expose to the browser
SANITY_API_READ_TOKEN=

# Server-only — required to enable secure preview / draft mode
SANITY_PREVIEW_SECRET=

# Public site URL — used for SEO canonicals, hreflang, sitemap, OG URLs, and Presentation preview
# Replace with the production domain before launch, e.g. https://example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
